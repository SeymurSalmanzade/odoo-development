<odoo>
    <data>
        <record id="sale_subscription_view_tree_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">sale.subscription.tree.inherit.ikma.addons</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_subscription.sale_subscription_view_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="project_number" groups="ikma_addons.group_ikma_azerbaijan_user"/>
                </field>
                <field name="recurring_total" position="before">
                    <field name="recurring_per_line" optional="show"/>
                </field>
            </field>
        </record>
    </data>
</odoo>
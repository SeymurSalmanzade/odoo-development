<odoo>
    <data>
        <!-- Inherit the CRM Quick Create View for Leads -->
        <record id="quick_create_opportunity_form_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">crm.lead.view.quick.create.inherit.ikma_addons</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="before">
                    <field name="opportunity_type_id" required="1" options="{'no_quick_create': True}" groups="ikma_addons.group_ikma_azerbaijan_user"/>
                    <field name="project_location"/>
                    <field name="equipment_type_ids" widget="many2many_tags"/>
                    <field name="equipment_qty"/>
                    <field name="sales_account_name" groups="ikma_addons.group_ikma_georgia_user"/>
                </field>
            </field>
        </record>

        <!-- Inherit the CRM Search View for Leads -->
        <record id="view_crm_case_opportunities_filter_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">crm.lead.view.search.inherit.ikma_addons</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="opportunity_no" string="Number"/>
                </field>
                <group position="inside">
                    <filter name="opportunity_type" string="Opportunity Type" context="{'group_by': 'opportunity_type_id'}" groups="ikma_addons.group_ikma_azerbaijan_user"/>
                </group>
            </field>
        </record>

        <!-- Inherit the CRM Form View for Leads -->
        <record id="crm_lead_view_form_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">crm.lead.view.form.inherit.ikma_addons</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('oe_title')][1]/h1" position="before">
                    <h1 invisible="type != 'opportunity'">
                        <field name="opportunity_no" class="text-break" options="{'line_breaks': False}" widget="text" readonly="1" groups="ikma_addons.group_ikma_azerbaijan_user"/>
                        <field name="opportunity_no" class="text-break" options="{'line_breaks': False}" widget="text" groups="ikma_addons.group_ikma_georgia_user"/>
                    </h1>
                </xpath>
                <xpath expr="//group[@name='opportunity_partner']" position="inside">
                    <label for="opportunity_type_id" invisible="type != 'opportunity'" groups="ikma_addons.group_ikma_azerbaijan_user"/>
                    <div class="o_row" invisible="type != 'opportunity'" groups="ikma_addons.group_ikma_azerbaijan_user">
                        <field name="opportunity_type_id" required="type == 'opportunity'" options="{'no_quick_create': True}"/>
                        <button name="regenerate_opportunity_no_prefix" type="object" icon="fa-refresh" string="Regenerate Prefix" class="btn btn-link" invisible="not opportunity_type_id" confirm="Are you sure you want to regenerate prefix?"/>
                    </div>
                    <field name="project_location"/>
                    <field name="equipment_type_ids" widget="many2many_tags"/>
                    <field name="equipment_qty"/>
                    <field name="sales_account_name" groups="ikma_addons.group_ikma_georgia_user"/>
                </xpath>
                <field name="lost_reason_id" position="after">
                    <field name="lost_feedback" invisible="active"/>
                </field>
            </field>
        </record>
        
        <!-- Inherit the CRM Kanban View for Leads -->
        <record id="crm_case_kanban_view_leads_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">crm.lead.kanban.view.inherit.ikma_addons</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_kanban_view_leads"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field class="fw-bold fs-5" name="opportunity_no"/>
                </field>
                <field name="tag_ids" position="after">
                    <div invisible="not equipment_type_ids">
                        <strong>Equipment Type:</strong> <field name="equipment_type_ids" widget="many2many_tags"/>
                    </div>
                    <div invisible="not equipment_qty">
                        <strong>Equipment Quantity:</strong> <field name="equipment_qty"/>
                    </div>
                </field>
            </field>
        </record>

        <!-- Inherit the CRM tree View for Leads -->
        <record id="crm_case_tree_view_oppor_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">crm.lead.view.tree.inherit.ikma_addons</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_tree_view_oppor"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="opportunity_no" widget="text" readonly="1"/>
                </field>
                <field name="name" position="after">
                    <field name="project_location" optional="hide"/>
                    <field name="equipment_type_ids" optional="hide" widget="many2many_tags"/>
                    <field name="equipment_qty" optional="hide"/>
                    <field name="sales_account_name" optional="hide" groups="ikma_addons.group_ikma_georgia_user"/>
                    <field name="lost_feedback" optional="hide" invisible="active"/>
                </field>
            </field>
        </record>
        
        <!-- Inherit the CRM Calendar View for Leads -->
        <record id="crm_case_calendar_view_leads_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">crm.lead.view.calendar.inherit.ikma_addons</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_case_calendar_view_leads"/>
            <field name="arch" type="xml">
                <field name="expected_revenue" position="before">
                    <field name="opportunity_no" widget="text"/>
                </field>
            </field>
        </record>
        
        <!-- Inherit the CRM Pivot View for Leads -->
        <record id="crm_lead_view_pivot_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">crm.lead.view.pivot.inherit.ikma_addons</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_pivot"/>
            <field name="arch" type="xml">
                <field name="create_date" position="before">
                    <field name="opportunity_no" type="row"/>
                </field>
            </field>
        </record>
        
        <!-- Inherit the CRM Graph View for Leads -->
        <record id="crm_lead_view_graph_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">crm.lead.view.pivot.inherit.ikma_addons</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_graph"/>
            <field name="arch" type="xml">
                <field name="stage_id" position="before">
                    <field name="opportunity_no"/>
                </field>
            </field>
        </record>
        
        <!-- Inherit the CRM Lead Activity View -->
        <record id="crm_lead_view_activity_inherit_ikma_addons" model="ir.ui.view">
            <field name="name">crm.lead.view.activity.inherit.ikma_addons</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_activity"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@t-name='activity-box']/div/div[1]" position="before">
                    <div class="d-flex justify-content-between">
                        <field name="opportunity_no" class="o_text_block o_text_bold"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
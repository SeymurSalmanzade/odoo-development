<odoo>
    <data>
        <template id="annex_raw">
            <t t-call="web.html_container">
                <t t-if="is_annexes_to_contract" t-set="docs" t-value="sale_order"/>
                <t t-foreach="docs" t-as="doc">
                    <t t-if="is_annexes_to_contract" t-set="annex_ids" t-value="doc._get_annexes_in_order_line()"/>
                    <t t-else="" t-set="annex_ids" t-value="env['sale.annex'].browse(env.context.get('annexes'))"/>
                    <t t-set="annex_number" t-value="1 if doc.contract_type in ['service', 'installation'] else 0"/>
                    <t t-foreach="annex_ids" t-as="annex">
                        <t t-set="annex_number" t-value="annex_number + 1"/>
                        <t t-call="ikma_addons.annex_template" t-lang="'az_AZ'"/>
                    </t>
                </t>
            </t>
        </template>

        <template id="annex_template" inherit_id="sale.report_saleorder_document" primary="True">
            <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
                <attribute name="t-call">ikma_addons.annex_layout_boxed</attribute>
            </xpath>
            <xpath expr="//t[@t-set='doc']" position="attributes">
                <attribute name="t-value">doc.with_context(lang='az_AZ')</attribute>
            </xpath>
            <xpath expr="//t[@t-set='address']" position="replace"/>
            <xpath expr="//t[@t-set='information_block']" position="replace"/>
            <xpath expr="//t[@t-set='layout_document_title']" position="replace"/>
            <xpath expr="//div[@id='informations']" position="replace"/>
            <xpath expr="//div[hasclass('page')]" position="before">
                <div name="annex_note_header">
                    <p>
                        <t t-if="doc.partner_id.lang == 'az_AZ'">
                            Bu əlavə ilə, <span t-field="doc.contract_partner_person_position"/> <span t-out="doc.contract_partner_person.name"/> 
                            şəxsində təmsil olunan gələcəkdə “Sifarişçi” adlandırılacaq <span t-field="doc.contract_partner_company_short"/> və 
                            <span t-field="doc.contract_executor_person_position"/> <span t-out="doc.contract_executor_person.name"/> şəxsində təmsil olunan gələcəkdə “İcraçı” adlandırılacaq 
                            <span t-out="doc.company_id.company_name_short"/> arasında imzalanmış <span t-field="doc.contract_number"/> saylı <span t-out="doc._get_format_date(doc.contract_date)"/> 
                            tarixli müqaviləyə dair aşağıdakı əlavə şərtləri müəyyən etdilər:
                        </t>
                        <t t-elif="doc.partner_id.lang == 'en_US'">
                            With this addendum, the following additional terms are defined for the contract No. <span t-field="doc.contract_number"/> dated 
                            <span t-out="doc._get_format_date(doc.contract_date)"/>, signed between <span t-field="doc.contract_partner_company_short"/>, 
                            hereinafter referred to as the “Customer”, represented by <span t-field="doc.contract_partner_person_position"/> <span t-out="doc.contract_partner_person.name"/>, 
                            and <span t-out="doc.company_id.company_name_short"/>, hereinafter referred to as the “Contractor”, represented by <span t-field="doc.contract_executor_person_position"/> 
                            <span t-out="doc.contract_executor_person.name"/>.
                        </t>
                    </p>
                    <p t-if="annex.note_header">
                        <span t-out="annex.note_header" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="annex_note_header"/>
                    </p>
                </div>
            </xpath>
            <xpath expr="//t[@t-set='lines_to_report']" position="attributes">
                <attribute name="t-value">doc._get_annex_order_lines(annex)</attribute>
            </xpath>
            <xpath expr="//t[@t-set='display_discount']" position="after">
                <div class="p-1 fw-bolder" t-att-style="'background-color: %s; color: white;' % doc.company_id.primary_color or 'DodgerBlue'">
                    <span style="font-size: large;">
                        Monthly technical service cost for equipment: 
                        (<t t-if="annex.assignment"><span t-out="annex.assignment"/> - </t><span t-out="annex.name"/>)
                    </span>
                </div>
                <br/>
            </xpath>
            <xpath expr="//table[hasclass('o_main_table')]/thead/tr" position="replace">
                <tr>
                    <th name="th_name">EQUIPMENT</th>
                    <th name="th_lift_number">NUMBER</th>
                    <th name="th_lift_type">TYPE</th>
                    <th name="th_lift_speed">SPEED (m/s)</th>
                    <th name="th_lift_load_capacity">LOAD CAPACITY (kg)</th>
                    <th name="th_lift_floor_number">NUMBER OF FLOORS</th>
                    <th name="th_lift_stop_number">NUMBER OF STOPS</th>
                    <th name="th_subtotal">SERVICE VALUE (AZN)</th>
                </tr>
            </xpath>
            <xpath expr="//t[@t-foreach='lines_to_report']" position="replace">
                <t t-set="current_subtotal" t-value="0"/>
                <t t-foreach="lines_to_report" t-as="line">
                    <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal"/>
                    <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                        <t t-if="not line.display_type">
                            <td name="td_name" class="text-center text-nowrap" style="border-bottom: 1px solid black;">
                                <span t-if="line.product_template_id.description_sale" t-field="line.product_template_id.description_sale"/>
                                <span t-else="" t-field="line.name"/>
                            </td>
                            <td name="td_lift_number" class="text-center" style="border-bottom: 1px solid black;">
                                <span t-field="line.lift_number"/>
                            </td>
                            <td name="td_lift_type" class="text-center" style="border-bottom: 1px solid black;">
                                <span t-field="line.lift_type"/>
                            </td>
                            <td name="td_lift_speed" class="text-center" style="border-bottom: 1px solid black;">
                                <span t-field="line.lift_speed"/>
                            </td>
                            <td name="td_lift_load_capacity" class="text-center" style="border-bottom: 1px solid black;">
                                <span t-field="line.lift_load_capacity" t-options="{'widget': 'float', 'precision': 2}"/>
                            </td>
                            <td name="td_lift_floor_number" class="text-center" style="border-bottom: 1px solid black;">
                                <span t-field="line.lift_floor_number"/>
                            </td>
                            <td name="td_lift_stop_number" class="text-center" style="border-bottom: 1px solid black;">
                                <span t-field="line.lift_stop_number"/>
                            </td>
                            <td t-if="not line.is_downpayment" name="td_subtotal" class="text-center o_price_total" style="border-bottom: 1px solid black;">
                                <span t-field="line.price_subtotal"/>
                            </td>
                        </t>
                    </tr>
                </t>
            </xpath>
            <xpath expr="//t[@t-set='tax_totals']" position="attributes">
                <attribute name="t-value">doc.annex_tax_totals[annex.id]</attribute>
            </xpath>
            <xpath expr="//div[@name='signature']" position="replace"/>
            <xpath expr="//p[@id='fiscal_position_remark']" position="replace"/>
            <xpath expr="//span[@name='order_note']" position="replace">
                <span t-out="annex.note_footer" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if doc.company_id.terms_type != 'html' else ''}" name="annex_note_footer"/>
            </xpath>
            <xpath expr="//span[@name='annex_note_footer']" position="after">
                <div class="row">
                    <div class="col-6">
                        <p>
                            <span t-field="doc.contract_partner_person_position"/>
                            <br/>
                            <span t-out="doc.contract_partner_person.name"/>
                        </p>
                        <br/>
                        <p>
                            <span>Sign________________(Stamp)</span>
                        </p>
                    </div>
                    <div class="col-5 offset-1">
                        <p>
                            <span t-field="doc.contract_executor_person_position"/>
                            <br/>
                            <span t-out="doc.contract_executor_person.name"/>
                        </p>
                        <br/>
                        <p>
                            <span>Sign________________(Stamp)</span>
                        </p>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>

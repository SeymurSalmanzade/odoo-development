<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>    
        <record id="contract_template_report" model="ir.actions.report">
            <field name="name">Contract</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ikma_addons.contract_template_raw</field>
            <field name="report_file">ikma_addons.contract_template_raw</field>
            <field name="print_report_name">object._get_print_report_name((dict(object._fields['contract_type'].selection).get(object.contract_type) or '') + ' Contract #' + (object.contract_number or ''))</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
            <field name="binding_view_types">list,form</field>
            <field name="paperformat_id" ref="ikma_addons.contract_paperformat"/>
            <field name="groups_id" eval="[(4, ref('ikma_addons.group_ikma_azerbaijan_user'))]"/>
        </record>
    </data>
</odoo>
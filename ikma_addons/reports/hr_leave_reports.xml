        <record id="hr_leave_request_report" model="ir.actions.report">
            <field name="name">Leave Request</field>
            <field name="model">hr.leave</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ikma_addons.hr_leave_request_template</field>
            <field name="report_file">ikma_addons.hr_leave_templates</field>
            <field name="print_report_name">'Leave Request - %s' % (object.display_name)</field>
            <field name="binding_model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="ikma_addons.hr_leave_paperformat"/>
            <field name="groups_id" eval="[(4, ref('ikma_addons.group_ikma_azerbaijan_user'))]"/>
        </record>


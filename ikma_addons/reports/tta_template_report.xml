<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>    
        <record id="tta_template_report" model="ir.actions.report">
            <field name="name">TTA</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">ikma_addons.tta_raw</field>
            <field name="report_file">ikma_addons.tta_raw</field>
            <field name="print_report_name">object._get_print_report_name('TTA ' + dict(object._fields['last_updated_tta_lang'].selection).get(object.last_updated_tta_lang) + ' #' + object.name + '/' + object.last_updated_tta_date.strftime('%m/%Y'))</field>
            <field name="paperformat_id" ref="ikma_addons.tta_paperformat"/>
            <field name="groups_id" eval="[(4, ref('ikma_addons.group_ikma_azerbaijan_user'))]"/>
        </record>
    </data>
</odoo>
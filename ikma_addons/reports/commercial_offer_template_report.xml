<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="commercial_offer_template_report" model="ir.actions.report">
        <field name="name">Commercial Offer</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ikma_addons.commercial_offer_raw</field>
        <field name="report_file">ikma_addons.commercial_offer_raw</field>
        <field name="print_report_name">object._get_print_report_name('Commercial Offer #' + object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="groups_id" eval="[(4, ref('ikma_addons.group_ikma_azerbaijan_user'))]"/>
    </record>
    <record id="report_commercial_offer_with_stamp" model="ir.actions.report">
        <field name="name">Commercial Offer with Stamp</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ikma_addons.commercial_offer_with_stamp</field>
        <field name="report_file">ikma_addons.commercial_offer_templates</field>
        <field name="print_report_name">object._get_print_report_name('Commercial Offer with Stamp #' + object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="groups_id" eval="[(4, ref('ikma_addons.group_ikma_azerbaijan_user'))]"/>
    </record>
</odoo>
<odoo>
    <data>
        <record id="tta_report_wizard_form" model="ir.ui.view">
            <field name="name">tta.report.wizard.form</field>
            <field name="model">tta.report.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="lang" widget="radio" required="1"/>
                        </group>
                        <group>
                            <field name="date" required="1" options="{'min_precision': 'months'}"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="with_stamp"/>
                            <field name="with_confirming"/>
                            <field name="with_partner_confirming"/>
                        </group>
                        <group>
                            <field name="without_handover_part"/>
                            <field name="with_handover" invisible="without_handover_part"/>
                            <field name="with_transferee" invisible="without_handover_part"/>
                        </group>
                    </group>
                    <separator/>
                    <group>
                        <field name="order_ids" readonly="1" nolabel="1" colspan="2"/>
                    </group>
                    <footer>
                        <button string="Print" type="object" name="print_tta_report" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

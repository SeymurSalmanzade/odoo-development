<odoo>
    <data>
        <record id="action_sale_order_line_views_from_ikma_addon" model="ir.actions.act_window">
            <field name="name">Order Lines</field>
            <field name="res_model">sale.order.line</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="context">{'create': False, 'delete': False, 'edit': False}</field>
        </record>

        <record id="sale_contract_info_action_window" model="ir.actions.act_window">
            <field name="name">Contract Info</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'list', 'view_id': ref('ikma_addons.sale_contract_info_view_list')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('ikma_addons.sale_contract_info_view_form')})]"/>
            <field name="search_view_id" ref="ikma_addons.sale_contract_info_view_search"/>
            <field name="domain">['&amp;', ('contract_type', 'not in', ('none',False)), ('is_existing_contract','=',False)]</field>
        </record>

        <record id="sale_annex_action_window" model="ir.actions.act_window">
            <field name="name">Annexes</field>
            <field name="res_model">sale.annex</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="tta_packages_action_window" model="ir.actions.act_window">
            <field name="name">TTA Packages</field>
            <field name="res_model">tta.packages</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="sale_contract_template_action_window" model="ir.actions.act_window">
            <field name="name">Contract Templates</field>
            <field name="res_model">sale.contract.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="sale_addendum_template_action_window" model="ir.actions.act_window">
            <field name="name">Addendum Templates</field>
            <field name="res_model">sale.addendum.template</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="crm_opportunity_type_action" model="ir.actions.act_window">
            <field name="name">Opportunity Types</field>
            <field name="res_model">crm.opportunity.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="crm_equipment_type_action" model="ir.actions.act_window">
            <field name="name">Equipment Types</field>
            <field name="res_model">crm.equipment.type</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    
    <template id="report_invoice_az">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang"/>
                <t t-call="task_template.report_invoice_document_inherited_task_template" t-lang="lang"/>
            </t>
            <t t-set="print_with_payments" t-value="True"/>
        </t>
    </template>

    <record id="invoice_az_report_temp" model="ir.actions.report">
        <field name="name">Invoice AZ</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">task_template.report_invoice_az</field>
        <field name="report_file">task_template.report_invoice_az</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
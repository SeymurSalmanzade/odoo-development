<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="external_layout_boxed_inherited_task_template" inherit_id="web.external_layout_boxed" primary="True">
            
            <xpath expr="/t/div[1]/div[1]/div[1]//div[hasclass('col-6')]" position="replace">
                <div class="col-6">
                    <img t-if="company.logo"
                         style="max-height: 100px; max-width: 160px;"
                         t-att-src="image_data_uri(company.logo)" 
                         alt="Logo"/>
                </div>
            </xpath>

                            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->



            <xpath expr="/t/div[1]/div[1]/div[1]/div[2]/div[2]/ul/li[1]/span[1]" position="attributes">
                <attribute name="t-options" add="{'widget': 'contact', 'fields': ['name', 'vat', 'address'], 'no_marker': True}"/>
            </xpath>

                            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <xpath expr="/t/div[2]/div[1]" position="attributes">
                <attribute name="class">pt-0</attribute>
            </xpath>

                            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
                
            <xpath expr="//div[@t-attf-class='footer o_boxed_footer o_company_#{company.id}_layout']" position="replace">
                <div t-attf-class="footer o_boxed_footer o_company_#{company.id}_layout" style="border-top: 1px solid black;">
                    <div class="row text-center">
                        <div class="col-4">
                           <u><span t-field="company.email"/></u>
                        </div>
                        <div class="col-4">
                            <strong><span t-field="company.phone"/></strong>
                            <br/>
                            <strong><span t-field="company.mobile"/></strong>
                        </div>
                        <div class="col-4">
                            <em><span t-field="company.website"/></em>
                        </div>
                    </div>
                </div>
                <!-- <div t-attf-class="footer o_boxed_footer o_company_#{company.id}_layout" style="border-top: 1px solid black;">
                    <div class="text-center">
                        <ul>
                            <div t-field="company.report_footer">Company Report Footer</div>
                        </ul>
                        <div t-if="report_type == 'pdf' and display_name_in_footer" class="text-muted">
                            <span t-out="o.name">(document name)</span>
                        </div>
                    </div>
                </div> -->
            </xpath>
                
        </template>

    </data>
</odoo>
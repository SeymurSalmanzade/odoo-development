<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <template id="report_invoice_document_inherited_task_template" inherit_id="account.report_invoice_document"
                    primary="True">
            
            <xpath expr="/t/t[@t-call='web.external_layout']" position="attributes">
                <attribute name="t-call">task_template.web_external_layout_inherited_task_template</attribute>
            </xpath>

            <!-- <xpath expr="/t/t[1]/div[2]/div[1]/div[4]/div[1]/div[1]/div[1]/table/t[2]" position="attributes">
                <attribute name="t-call">task_template.tax_totals_inherited_task_template</attribute>
            </xpath> -->

                        <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <xpath expr="/t/t[1]/div[2]/div[1]/h2" position="attributes">
                <attribute name="style" add="margin-bottom: 0rem;"/>    
            </xpath>

            <xpath expr="/t[1]/t[1]/div[2]/div[1]/div[1]" position="attributes">
                <attribute name="style" add="min-height: 0lh;"/>
            </xpath>

            <xpath expr="/t[1]/t[1]/div[2]/div[1]/div[2]" position="attributes">
                <attribute name="class">row</attribute>
            </xpath>

            <xpath expr="/t[1]/t[1]/div[2]/div[1]/div[3]" position="attributes">
                <attribute name="style" add="min-height: 0lh;"/>
            </xpath>

                             <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            
            <xpath expr="/t/t[1]/div[1]/t[2]/div[1]" position="after">
                <div class="col-6">
                    <t  t-if="o.partner_bank_id.bank_id" t-set="company_personal_information_block">
                        <div style="position:relative; top:-3rem;">
                            <strong><span>Company Details:</span></strong>
                            <div name="company_acc_holder_name">
                                <br/>
                                <b><div t-if="o.partner_bank_id.acc_holder_name" t-field="o.partner_bank_id.acc_holder_name"/></b>
                            </div>
                            <div t-if="o.company_id.vat" name="company_vat">
                                <span>Tax ID:</span>
                                <span t-field="o.company_id.vat"/>
                            </div>
                            <div t-if="o.partner_bank_id.acc_number" name="company_acc_number">
                                <span>Account No.:</span>
                                <span t-field="o.partner_bank_id.acc_number"/>
                            </div>
                            <div t-if="o.partner_bank_id.bank_id.name" name="company_bank_id">
                                <span>Bank:</span>
                                <span t-field="o.partner_bank_id.bank_id.name"/>
                            </div>
                            <div t-if="o.partner_bank_id.bank_id.bic" name="company_bank_bic">
                                <span>BIC:</span>
                                <span t-field="o.partner_bank_id.bank_id.bic"/>
                            </div>
                            <div t-if="o.partner_bank_id.bank_id.tax_id" name="company_bank_vat">
                                <span>Bank Tax ID:</span>
                                <span t-field="o.partner_bank_id.bank_id.tax_id"/>
                            </div>
                            <div t-if="o.partner_bank_id.bank_id.swift" name="company_bank_swift">
                                <span>Swift:</span>
                                <span t-field="o.partner_bank_id.bank_id.swift"/>
                            </div>
                            <div t-if="o.partner_bank_id.muxbir_hesab" name="company_mh">
                                <span>C/A:</span>
                                <span t-field="o.partner_bank_id.muxbir_hesab"/>
                            </div>
                        </div>
                    </t>
                </div>
            </xpath>

                    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            
            <xpath expr="/t/t/div[1]/t[2]/div" position="replace">
                <div class="offset-col-6 col-6" name="address_same_as_shipping">
                    <t t-set="address">
                        <address class="mb-0" t-field="o.partner_id"/>
                        <div t-if="o.partner_id.vat" id="partner_vat_address_same_as_shipping">
                            <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label"/>
                            <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                        </div>
                    </t>
                </div>
            </xpath>
            
                        <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            
            <xpath expr="/t/t/div[2]/div[1]/table/thead/tr" position="replace">
                <tr>
                    <th name="th_item_number" class="text-center"><span>Nº</span></th>
                    <th name="th_description" class="text-center"><span>Description</span></th>
                    <!-- <th name="th_brand" class="text-center"><span>Brand</span></th> -->
                    <th name="th_quantity" class="text-center"><span>Quantity</span></th>
                    <th name="th_priceunit" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Unit Price</span></th>
                    <th name="th_discount" t-if="display_discount" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                        <span>Disc.%</span>
                    </th>
                    <th name="th_taxes" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Taxes</span></th>
                    <th name="th_subtotal" class="text-center">
                        <span>Amount</span>
                    </th>
                </tr>
            </xpath>

                        <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <xpath expr="/t/t[1]/div[2]/div[1]/table[1]/tbody[1]" position="before">
                <t t-set="item_number" t-value="0"/>
            </xpath>

            
            <xpath expr="/t/t/div[2]/div[1]/table/tbody/t/tr" position="replace">
                <tr style="border-bottom: 1px solid black;" t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                    <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                        <!-- <t t-if="line.display_type == 'line_section'">
                             
                        </t>
                        <t t-elif="line.display_type == 'line_note'">
                             
                        </t>
                        <t t-else=""> -->
                        <t t-set="item_number" t-value="item_number + 1"/>
                        <td name="td_item_number"><span t-out="item_number"/></td>
                        <td class="text-center" name="account_invoice_line_name"><span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Bacon Burger</span></td>
                        <!-- <td name="td_brand" class="text-center"><span t-field="line.product_id.brand"/></td> -->
                        <td name="td_quantity" class="text-center">
                            <span t-field="line.quantity">3.00</span>
                            <span t-field="line.product_uom_id" groups="uom.group_uom">units</span>
                        </td>
                        <td name="td_price_unit" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span class="text-nowrap" t-field="line.price_unit">9.00</span>
                        </td>
                        <td name="td_discount" t-if="display_discount" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span class="text-nowrap" t-field="line.discount">0</span>
                        </td>
                        <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.tax_ids])"/>
                        <td name="td_taxes" t-attf-class="text-center {{ 'd-none d-md-table-cell' if report_type == 'html' else ''}}">
                            <span t-out="taxes" id="line_tax_ids">Tax 15%</span>
                        </td>
                        <td name="td_subtotal" class="text-center o_price_total">
                            <span class="text-nowrap" t-field="line.price_subtotal">27.00</span>
                        </td>
                    </t>
                    <t t-elif="line.display_type == 'line_section'">
                        <td colspan="99" t-attf-class="text-center">
                            <span t-field="line.name" t-options="{'widget': 'text'}">A section title</span>
                        </td>
                        <t t-set="current_section" t-value="line"/>
                        <t t-set="current_subtotal" t-value="0"/>
                    </t>
                    <t t-elif="line.display_type == 'line_note'">
                        <td colspan="99" t-attf-class="text-center">
                            <span t-field="line.name" t-options="{'widget': 'text'}">A note, whose content usually applies to the section or product above.</span>
                        </td>
                    </t>
                </tr>
            </xpath>

                    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <xpath expr="/t/t/div[2]/div[1]/div[4]/div/div/div/table" position="replace">
                <table class="table table-sm table-borderless avoid-page-break-inside">

                    <!--Tax totals-->
                    <t t-set="tax_totals" t-value="o.tax_totals"/>
                    <t t-call="account.document_tax_totals"/>
                    <!--Payments-->
                    <t t-if="o.payment_state != 'invoicing_legacy'">
                        <t t-set="payments_vals" t-value="o.sudo().invoice_payments_widget and o.sudo().invoice_payments_widget['content'] or []"/>
                        <t t-foreach="payments_vals" t-as="payment_vals">
                            <tr class="text-center" t-if="payment_vals['is_exchange'] == 0">
                                <td>
                                    <i class="oe_form_field oe_payment_label">Paid on <t t-out="payment_vals['date']" t-options="{'widget': 'date'}">2021-09-19</t></i>
                                </td>
                                <td>
                                    <span t-out="payment_vals['amount']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}">20.00</span>
                                </td>
                            </tr>
                        </t>
                        <t t-if="len(payments_vals) &gt; 0">
                            <tr class="text-center border-black fw-bold">
                                <td>Amount Due</td>
                                <td>
                                    <span t-field="o.amount_residual">11.05</span>
                                </td>
                            </tr>
                        </t>
                    </t>
                </table>
            </xpath>

                        <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <xpath expr="/t/t/div[2]/div[1]/div[4]/div[2]/div[2]/span[@id='payment_terms_note_id']" position="replace">

            </xpath>

                        <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <xpath expr="/t/t[1]/div[2]/div[1]/div[2]/div[7]" position="after">
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_payment_term_id" name="payment_terms">
                    <strong>Payment Terms:</strong><br/>
                    <span t-field="o.invoice_payment_term_id">Payment within 30 calendar day</span>
                </div>
            </xpath>

                        <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->

            <xpath expr="/t/t[1]/div[2]/div[1]/div[4]/div[1]/div[1]/div[1]/table" position="after">
                <div name="director and sign" class="text-end" style="float:right; position:relative">
                    <table class="table table-sm table-borderless avoid-page-break-inside" style="border: 0px;">
                            <tr>
                                <td class="text-center" style="border: 1px solid black; height:60px; width:160px;">
                                    <img t-if="o.company_id.director_sign"
                                         t-attf-src="data:image/png;base64, #{o.company_id.director_sign}"
                                         alt="Director's Sign"
                                         style="height: 80px; width: 200px;"/>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-start" style="border: 0px;background-color:white;">
                                    <span><strong>Director:</strong></span>
                                    <span t-if="o.company_id.director" style="color: black; font-weight: bold;" t-field="o.company_id.director"/>
                                </td>
                            </tr>
                    </table>
                </div>
                <div class="float-end">
                    <img class="img-fluid" style="max-height:200px; max-width:200px;" 
                        t-attf-src="data:image/png;base64, #{o.company_id.stamp}"/>
              </div>
            </xpath>

                                    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
        </template>
        
    </data>
</odoo>
                <t t-if="not display_tax_base">
                    <td class="text-center"><span class="text-nowrap" t-out="amount_by_group['tax_group_name']">Tax 15%</span></td>
                    <td class="text-center o_price_total">
                        <span class="text-nowrap" t-out="amount_by_group['formatted_tax_group_amount']">1.05</span>
                    </td>
                </t>
                <t t-else="">

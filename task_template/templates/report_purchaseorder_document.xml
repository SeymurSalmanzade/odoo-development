<odoo>
    
    <data>
        <record id="report_purchase_order_inherited" model="ir.ui.view">
            <field name="inherit_id" ref="purchase.report_purchaseorder_document"/>
            <field name="name">Purchase template:inherited changes</field>
            <field name="type">qweb</field>
            <field name="arch" type="xml">
                <xpath expr="//t[@t-set='address']" position="replace">
                    <t t-set="address">
                        <strong>Vendor:</strong>
            <div t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['name', 'phone', 'vat'], 'no_marker': True}"/>
                    </t>
                </xpath>
                <xpath expr="//t[@t-set='information_block']" position="replace">
                    <t t-set="address">
                        <strong>Shipping address:</strong>
                    <div t-if="o.dest_address_id">
                        <div t-field="o.dest_address_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True}" name="purchase_shipping_address"/>
                    </div>
                    </t>
                </xpath>
                <xpath expr="//tbody[1]/t[@t-set='current_subtotal']" position="before">
                    <t t-set="item_number" t-value="0"/>
                </xpath>
                <xpath expr="//thead/tr" position="replace">
                    <tr class="text-center">
                        <th name="th_numbering" class="text-start">№</th>
                        <th name="th_description"><strong>Description</strong></th>
                        <th name="th_taxes"><strong>Taxes</strong></th>
                        <th name="th_date_req"><strong>Date Req.</strong></th>
                        <th name="th_quantity"><strong>Qty</strong></th>
                        <th name="th_price_unit"><strong>Unit Price</strong></th>
                        <th name="th_subtotal">
                            <strong>Amount</strong>
                        </th>
                    </tr>
                </xpath>
                <xpath expr="//table/tbody[1]/t[3]/tr[1]" position="replace">
                    <tr style="border-bottom: 1px solid black;" t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                        <t t-if="not line.display_type">
                            <t t-if="line.display_type != 'line_note' and line.display_type != 'line_section' ">
                                <t t-set="item_number" t-value="item_number + 1"/>
                                <td class="text-start" name="td_item_number"><span t-out="item_number"/></td>
                            </t>
                            <td id="product" class="text-center">
                                <span t-field="line.name"/>
                            </td>
                            <t t-set="taxes" t-value="', '.join([(tax.invoice_label or tax.name) for tax in line.taxes_id])"/>
                            <td name="td_taxes" t-attf-class="{{ 'text-nowrap' if len(taxes) &lt; 10 else '' }}">
                                <span t-out="taxes">Tax 15%</span>
                            </td>
                            <td class="text-center">
                                <span t-field="line.date_planned"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.product_qty"/>
                                <span t-field="line.product_uom.name" groups="uom.group_uom"/>
                                <span t-if="line.product_packaging_id">
                                    (<span t-field="line.product_packaging_qty" t-options="{'widget': 'integer'}"/> <span t-field="line.product_packaging_id"/>)
                                </span>
                            </td>
                            <td class="text-center">
                                <span t-field="line.price_unit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.price_subtotal" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                            </td>
                        </t>
                        <t t-if="line.display_type == 'line_section'">
                            <td class="text-center" colspan="99" id="section">
                                <span t-field="line.name"/>
                            </td>
                            <t t-set="current_section" t-value="line"/>
                            <t t-set="current_subtotal" t-value="0"/>
                        </t>
                        <t t-if="line.display_type == 'line_note'">
                            <td class="text-center" colspan="99" id="note">
                                <span t-field="line.name"/>
                            </td>
                        </t>
                    </tr>
                </xpath>
                <xpath expr="//td[@name='td_taxes']" position="replace">
                   <td name="td_taxes" class="text-center">
                        <span t-out="taxes">Tax 15%</span>
                   </td>
                </xpath>
                <xpath expr="//div[@id='informations']" position="replace">
                    <div id="informations" class="row">
                        <div t-if="o.user_id" class="col-3 bm-2">
                            <strong>Purchase Representative:</strong>
                            <p t-field="o.user_id" class="m-0"/>
                        </div>
                        <div t-if="o.partner_ref" class="col-3 bm-2">
                            <strong>Your Order Reference:</strong>
                            <p t-field="o.partner_ref" class="m-0"/>
                        </div>
                        <div t-if="o.state in ['purchase','done'] and o.date_approve" class="col-3 bm-2">
                            <strong>Order Date:</strong>
                            <p t-field="o.date_approve" class="m-0"/>
                        </div>
                        <div t-elif="o.date_order" class="col-3 bm-2">
                            <strong>Order Deadline:</strong>
                            <p t-field="o.date_order" class="m-0"/>
                        </div>
                    </div>
                    <div id="payment-terms" class="row">
                        <div t-if="o.payment_term_id" class="col-3 bm-2">
                            <strong>Payment Terms:</strong>
                            <p t-field="o.payment_term_id" class="m-0"/>
                        </div>
                        <div t-if="o.ship_by" class="col-3 bm-2">
                            <strong>Ship By:</strong>
                            <p t-field="o.ship_by" class="m-0"/>
                        </div>
                    </div>
                </xpath>
                <xpath expr="//div[hasclass('mt-4')]" position="attributes">
                    <attribute name="class">mt-0</attribute>
                </xpath>
            </field>
         </record>  
    </data>

</odoo>
<odoo>
    <data>

        <record id="tta_packages_view_list" model="ir.ui.view">
            <field name="name">tta.packages.view.list</field>
            <field name="model">tta.packages</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="tta_packages_view_form" model="ir.ui.view">
            <field name="name">tta.packages.view.form</field>
            <field name="model">tta.packages</field>
            <field name="arch" type="xml">
                <form>
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" nolabel="1" placeholder="Package Name.."/>
                        </h1>
                    </div>
                    <separator/>
                    <group>
                        <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <group string="AZ">
                            <field name="note_az" colspan="2" nolabel="1" placeholder="TTA Note in AZ..."/>
                        </group>
                        <group string="EN">
                            <field name="note_en" colspan="2" nolabel="1" placeholder="TTA Note in EN..."/>
                        </group>
                    </group>
                </form>
            </field>
        </record> 
    </data>
</odoo>
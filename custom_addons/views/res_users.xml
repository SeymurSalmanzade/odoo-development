<odoo>
  <data>
    <record id="res_users_form_inherit" model="ir.ui.view">
      <field name="name">custom.res.users.form.inherit</field>
      <field name="model">res.users</field>
      <field name="inherit_id" ref="base.view_users_form" />
      <field name="arch" type="xml">
        <notebook position="inside">
          <page string="Consumption/Internal locations">
            <group>
              <group>
                <field name="consumption_location_id"
                  context="{'default_usage': 'inventory', 'default_scrap_location': True}" />
              </group>
              <group>
                <field name="internal_location_id" context="{'default_usage': 'internal'}" />
              </group>
            </group>
          </page>
        </notebook>
      </field>
    </record>
  </data>
</odoo>
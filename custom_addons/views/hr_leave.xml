<odoo>
    <data>
        <record id="hr_leave_view_form_inherit_custom_addons" model="ir.ui.view">
            <field name="name">hr.leave.view.form.inherit.custom_addons</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
            <field name="arch" type="xml">
                <field name="user_id" position="after">
                    <field name="order_number" groups="custom_addons.group_custom_azerbaijan_user"/>
                    <field name="order_date" groups="custom_addons.group_custom_azerbaijan_user"/>
                    <label for="working_year_from" string="Working Year" groups="custom_addons.group_custom_azerbaijan_user"/>
                    <div class="o_row" groups="custom_addons.group_custom_azerbaijan_user">
                        <field name="working_year_from" placeholder="Date from"/>
                        <i class="fa fa-long-arrow-right" aria-label="Arrow icon" title="Arrow"/>
                        <field name="working_year_to" placeholder="Date to"/>
                    </div>
                    <field name="working_start_date" groups="custom_addons.group_custom_azerbaijan_user"/>
                    <field name="businness_trip_location" placeholder="e.g. to Ismayilli" groups="custom_addons.group_custom_azerbaijan_user"/>
                </field>
            </field>
        </record>
    </data>
</odoo>

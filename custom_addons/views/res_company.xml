<odoo>
    <data>
        <record id="res_company_view_order_form_inherit" model="ir.ui.view">
            <field name="name">res.company.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="company_name_short" placeholder="“CUSTOM LIFT” MMC" groups="custom_addons.group_custom_azerbaijan_user"/>
                </xpath>
                <xpath expr="//page[@name='general_info']/group[1]/group[1]/field[@name='currency_id']" position="after">
                    <field name="director"/>
                    <field name="director_sign" widget="image" options="{'size': [0,150]}"/>
                </xpath>
                <xpath expr="//field[@name='color']" position="after">
                    <field name="stamp" widget="image" options="{'size': [200,200]}"/>
                </xpath>
            </field>
        </record>
      </data>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="annex_template_report" model="ir.actions.report">
        <field name="name">Annex</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_addons.annex_raw</field>
        <field name="report_file">custom_addons.annex_raw</field>
        <field name="print_report_name">object._get_print_report_name('Annex #' + object.name)</field>
        <field name="paperformat_id" ref="custom_addons.contract_paperformat"/>
        <field name="groups_id" eval="[(4, ref('custom_addons.group_custom_azerbaijan_user'))]"/>
    </record>
</odoo>

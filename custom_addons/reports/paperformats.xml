<odoo>
    <data>
        <record id="contract_paperformat" model="report.paperformat">
            <field name="name">A4 Contract Paperformat</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_bottom">15</field>
        </record>

        <record id="tta_paperformat" model="report.paperformat">
            <field name="name">A4 TTA Paperformat</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">35</field>
            <field name="header_spacing">30</field>
            <field name="margin_bottom">0</field>
        </record>
        
        <record id="hr_leave_paperformat" model="report.paperformat">
            <field name="name">A4 HR Leave Paperformat</field>
            <field name="format">A4</field>
            <field name="orientation">Portrait</field>
            <field name="margin_bottom">15</field>
            <field name="margin_top">15</field>
        </record>
    </data>
</odoo>
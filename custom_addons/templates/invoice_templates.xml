<odoo>
    <data>
        <template id="report_invoice_with_stamp">
            <t t-call="account.report_invoice">
                <t t-set="is_sign_and_stamp" t-value="True"/>
            </t>
        </template>
        
        <template id="account_report_invoice_document_inherit" inherit_id="account.report_invoice_document">

            <!-- Default changes transfered from invoice_report_template_erpgo module -->
            <xpath expr="//div[hasclass('invoice_main')]" position="before">
                <head>
                    <meta charset="UTF-8"/>
                    <style>
                        .o_report_layout_boxed table thead tr th {
                            text-align: center !important;
                        }
                        .o_report_layout_boxed table tbody tr td {
                            text-align: center !important; 
                        }
                        #informations .col {
                            flex: 0 0 auto;
                            width: 25%;
                        }
                        .report-wrapping-flexbox {
                            display: block !important;
                        }
                        .report-wrapping-flexbox > .col {
                            float: left;
                        }
                    </style>
                </head>
            </xpath>
            <xpath expr="//div[@id='informations']" position="attributes">
                <attribute name="class" remove="mb-4" add="report-wrapping-flexbox clearfix" separator=" "/>
            </xpath>
            <xpath expr="/t/t[@t-call='web.external_layout']/div[1]" position="inside">
                <t t-if="o.partner_bank_id.bank_id" t-set="company_personal_information_block">
                    <div name="company_acc_holder_name">
                        <b>
                            <div t-if="o.partner_bank_id.acc_holder_name"
                                t-field="o.partner_bank_id.acc_holder_name" />
                        </b>
                    </div>
                    <div t-if="o.company_id.vat" name="company_vat">
                        <span>Tax ID:</span>
                        <span t-field="o.company_id.vat" />
                    </div>
                    <div t-if="o.partner_bank_id.bank_id.name" name="company_bank_id">
                        <strong>
                            <span>Bank Requisites:</span>
                        </strong>
                        <br />
                        <span>Bank:</span>
                        <span t-field="o.partner_bank_id.bank_id.name" />
                    </div>
                    <div t-if="o.partner_bank_id.bank_tax_id" name="company_bank_vat">
                        <span>Bank Tax ID:</span>
                        <span t-field="o.partner_bank_id.bank_tax_id" />
                    </div>
                    <div t-if="o.partner_bank_id.bank_id.bic" name="company_bank_bic">
                        <span>Bank Code:</span>
                        <span t-field="o.partner_bank_id.bank_id.bic" />
                    </div>
                    <div t-if="o.partner_bank_id.bank_swift" name="company_bank_branch_code">
                        <span>Swift:</span>
                        <span t-field="o.partner_bank_id.bank_swift" />
                    </div>
                    <div t-if="o.partner_bank_id.correspondent_bank_name" name="company_cb">
                        <span>Correspondent Bank:</span>
                        <span t-field="o.partner_bank_id.correspondent_bank_name" />
                    </div>
                    <div t-if="o.partner_bank_id.correspondent_bank_swift" name="company_cbswift">
                        <span>Correspondent Bank SWIFT:</span>
                        <span t-field="o.partner_bank_id.correspondent_bank_swift" />
                    </div>
                    <div t-if="o.partner_bank_id.muxbir_hesab" name="company_mh">
                        <span>Correspondent Acc:</span>
                        <span t-field="o.partner_bank_id.muxbir_hesab" />
                    </div>
                    <div t-if="o.partner_bank_id.acc_number" name="company_acc_number">
                        <span>Beneficiary Acc:</span>
                        <span t-field="o.partner_bank_id.acc_number" />
                    </div>
                </t>
            </xpath>
            <xpath expr="//th[@name='th_description']" position="before">
                <th name="th_numbering" class="text-center">
                    <span>Nº</span>
                </th>
            </xpath>
            <xpath expr="//t[@t-foreach='lines']" position="before">
                <t t-set="item_number" t-value="0" />
            </xpath>
            <xpath expr="//td[@name='account_invoice_line_name']" position="before">
                <t t-set="item_number" t-value="item_number + 1"/>
                <td name="td_item_number">
                    <span t-out="item_number"/>
                </td>
            </xpath>
            <xpath expr="//div[@id='right-elements']" position="inside">
                <div name="director_details" class="avoid-page-break-inside">
                    <div class="row">
                        <div t-if="o.company_id.director_sign" t-att-class="'col-5' if o.company_id.stamp else 'text-center'">
                            <img
                                t-attf-src="data:image/image_type;base64, #{o.company_id.director_sign}"
                                t-att-style="'width: 4cm; height: 2cm;' + ('margin-top: 4rem;' if o.company_id.stamp else '')"
                                alt="Director's Sign" />
                        </div>
                        <div t-if="o.company_id.stamp" t-att-class="'col-7' if o.company_id.director_sign else 'text-center'">
                            <img
                                t-attf-src="data:image/image_type;base64, #{o.company_id.stamp}"
                                style="width:5cm; height: 5cm;"
                                alt="Stamp" />
                        </div>
                    </div>
                    <div class="row" t-if="o.company_id.director">
                        <p class="text-center">
                            <span t-att-style="'color: %s;' % o.company_id.primary_color">
                                <strong>Director:</strong>
                            </span>
                            <span class="fw-bolder" t-field="o.company_id.director"/>
                        </p>
                    </div>
                </div>
            </xpath>
            <!--  -->

            <!-- CUSTOM changes -->
            <xpath expr="//div[@id='total']//table" position="after">
                <p class="text-end lh-sm" groups="custom_addons.group_custom_azerbaijan_user">
                    <medium class="text-muted lh-sm">
                        <span t-if="o.partner_id.lang == 'az_AZ' and o.text_amount" t-out="o.text_amount.capitalize()"/>
                        <span t-else="" t-out="o.amount_total_words"/>
                    </medium>
                </p>
            </xpath>
            <xpath expr="//div[@name='director_details']" position="attributes">
                <attribute name="t-if">env.context.get('is_sign_and_stamp', False) or is_sign_and_stamp</attribute>
            </xpath>
            <xpath expr="//div[@name='director_details']//div[@t-if='o.company_id.stamp']/img" position="attributes">
                <attribute name="style">width:8.50cm; height: 5.2cm;</attribute>
            </xpath>
            <xpath expr="//td[@name='account_invoice_line_name']/span" position="attributes">
                <attribute name="groups">!custom_addons.group_custom_azerbaijan_user</attribute>
            </xpath>
            <xpath expr="//td[@name='account_invoice_line_name']/span" position="after">
                <span t-out="line.product_id.name or line.name" groups="custom_addons.group_custom_azerbaijan_user"/>
            </xpath>
            <xpath expr="//div[@name='due_date']" position="attributes">
                <attribute name="groups">!custom_addons.group_custom_azerbaijan_user</attribute>
            </xpath>
            <xpath expr="//div[@name='origin']" position="attributes">
                <attribute name="groups">!custom_addons.group_custom_azerbaijan_user</attribute>
            </xpath>
            <xpath expr="//div[@name='delivery_date']" position="attributes">
                <attribute name="groups">!custom_addons.group_custom_azerbaijan_user</attribute>
            </xpath>
            <xpath expr="//div[@name='customer_code']" position="attributes">
                <attribute name="groups">!custom_addons.group_custom_azerbaijan_user</attribute>
            </xpath>
            <xpath expr="//div[@name='incoterm_id']" position="attributes">
                <attribute name="groups">!custom_addons.group_custom_azerbaijan_user</attribute>
            </xpath>
            <xpath expr="//td[@name='td_quantity']/span[@t-field='line.quantity']" position="attributes">
                <attribute name="groups">!custom_addons.group_custom_azerbaijan_user</attribute>
            </xpath>
            <xpath expr="//td[@name='td_quantity']/span[@t-field='line.quantity']" position="after">
                <span groups="custom_addons.group_custom_azerbaijan_user" t-field="line.quantity" class="text-nowrap" t-options="{'widget': 'float', 'precision': 2}">3.00</span>
            </xpath>
            <xpath expr="//td[@name='td_price_unit']/span" position="attributes">
                <attribute name="groups">!custom_addons.group_custom_azerbaijan_user</attribute>
            </xpath>
            <xpath expr="//td[@name='td_price_unit']/span" position="after">
                <span groups="custom_addons.group_custom_azerbaijan_user" class="text-nowrap" t-field="line.price_unit" t-options="{'widget': 'float', 'precision': 2}">9.00</span>
            </xpath>
            <xpath expr="//td[@name='td_discount']/span" position="attributes">
                <attribute name="groups">!custom_addons.group_custom_azerbaijan_user</attribute>
            </xpath>
            <xpath expr="//td[@name='td_discount']/span" position="after">
                <span groups="custom_addons.group_custom_azerbaijan_user" class="text-nowrap" t-field="line.discount" t-options="{'widget': 'integer'}">0</span>
            </xpath>
            <xpath expr="//div[@id='payment_term']" position="after">
                <div name="director_sign_and_stamp" class="mt-3 avoid-page-break-inside" t-if="not is_sign_and_stamp" groups="custom_addons.group_custom_azerbaijan_user">
                    <div class="col-6">
                        <span t-out="o.company_id.company_name_short"/> Director<br/>
                        <span t-out="o.company_id.director"/>
                        <p class="border-bottom w-75 mt-5">
                            <span class="text-start text-muted">Sign</span>
                            <span class="float-end text-muted">Stamp</span>
                        </p>
                    </div>
                </div>
            </xpath>
            <!--  -->
        </template>

        <template id="service_invoice" inherit_id="account.report_invoice" primary="True">
            <xpath expr="//t[@t-call='account.report_invoice_document']" position="attributes">
                <attribute name="t-call">custom_addons.service_invoice_document</attribute>
            </xpath>
        </template>

        <template id="service_invoice_with_stamp">
            <t t-call="custom_addons.service_invoice">
                <t t-set="is_sign_and_stamp" t-value="True"/>
            </t>
        </template>

        <template id="service_invoice_document" inherit_id="account.report_invoice_document" primary="True">
            <xpath expr="//t[@t-set='layout_document_title']" position="replace">
                <h2>
                    <span>Invoice</span>
                    <span t-if="o.name != '/'" t-field="o.name">INV/2023/0001</span>
                </h2>
            </xpath> 
            <xpath expr="//div[@name='invoice_date']" position="replace">
                <div class="col" t-if="o.invoice_date" name="invoice_date">
                    <strong>Date:</strong><br/>
                    <span>__ <span t-out="o._get_format_date(o.invoice_date, date_format='MMMM yyyy').capitalize()"/></span>
                </div>
            </xpath>
            <xpath expr="//div[@id='informations']" position="inside">
                <div class="col text-center" name="equipment_number">
                    <strong>Total Number of Equipment:</strong><br/>
                    <span t-out="len(o.invoice_line_ids.filtered(lambda l: l.display_type == 'product'))"/>
                </div>
            </xpath>
            <xpath expr="//div[@id='informations']" position="after">
                <div class="row mb-1">
                    <strong t-att-style="'color: %s;' % o.company_id.primary_color or 'DodgerBlue'">Equipment Numbers: </strong>
                    <small><t t-out="', '.join([line.product_id.name or line.name for line in o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')])"/></small>
                </div>
                <div class="p-1 fw-bolder" t-att-style="'background-color: %s; color: white;' % o.company_id.primary_color or 'DodgerBlue'">
                    Purpose of payment: Monthly maintenance
                </div>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="replace">
                <tr>
                    <th name="th_period" class="text-center"><span>Period</span></th>
                    <th name="th_description" class="text-center"><span>Description</span></th>
                    <th name="th_quantity" class="text-center"><span>Quantity (Month)</span></th>
                    <th name="th_total" class="text-center"><span>Amount</span></th>
                </tr>
            </xpath>
            <xpath expr="//t[@t-foreach='lines']" position="replace"/>
            <xpath expr="//table[@name='invoice_line_table']/tbody" position="inside">
                <tr>
                    <td name="td_period" class="text-center">
                        <span t-out="o._get_format_date(o.invoice_date, date_format='MMMM yyyy').capitalize()"/>
                    </td>
                    <td name="th_description" class="text-center">
                        <span t-field="o.service_invoice_description"/>
                    </td>
                    <td name="td_quantity" class="text-center">
                        <span t-field="o.service_invoice_month_count"/>
                    </td>
                    <td name="td_total" class="text-center o_price_total">
                        <span t-field="o.amount_total"/>
                    </td>
                </tr>
            </xpath>
            <xpath expr="//div[@name='comment']" position="attributes">
                <attribute name="t-if">not is_html_empty(o.service_invoice_note)</attribute>
            </xpath>
            <xpath expr="//div[@name='comment']/span" position="attributes">
                <attribute name="t-field">o.service_invoice_note</attribute>
            </xpath>
        </template>
    </data>
</odoo>

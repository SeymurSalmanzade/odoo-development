<odoo>
  <data>

    <!-- mb_companies_list_view -->
    <record model="ir.ui.view" id="mb_companies_list_view">
      <field name="name">mb_companies_list_view</field>
      <field name="model">mb_companies</field>
      <field name="arch" type="xml">
        <tree>
            <field name="name"/>
            <field name="company_registry_id"/>
            <field name="company_phone"/>
            <field name="company_mobile"/>
            <field name="company_email"/>
        </tree>
      </field>
    </record>

    <!-- mb_companies_form_view -->
    <record model="ir.ui.view" id="mb_companies_form_view">
      <field name="name">mb_companies_form_view</field>
      <field name="model">mb_companies</field>
      <field name="arch" type="xml">
        <form>
            <field name="company_logo" widget="image" class="oe_avatar"/>
            <group>
                <field name="name"/>
                <span class="o_form_label o_td_label" name="address_name">
                    <b>Address</b>
                </span>
                <div class="o_address_format">
                    <field name="street" placeholder="Street..." class="o_address_street"/>
                    <field name="city" placeholder="City" class="o_address_city"/>
                    <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                    <div name="partner_address_country" class="d-flex justify-content-between">
                        <field name="country_id" placeholder="Country" class="o_address_country" options="{'no_open': True, 'no_create': True}"/>
                    </div>
                </div>
                <field name="company_vat"/>
                <field name="company_registry_id"/>
                <field name="company_phone"/>
                <field name="company_mobile" widget="phone"/>
                <field name="company_email" widget="email"/>
                <field name="company_website" widget="url"/>
                <field name="company_color" widget="color"/>
                <field name="company_members_id" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" 
                    context="{'tree_view_ref':'book_store.mb_sellers_ref_list_view', 'form_view_ref':'book_store.mb_sellers_ref_form_view'}"/>
            </group>
        </form>
      </field>
    </record>

      
    <!-- mb_companies_action_window -->
    <record model="ir.actions.act_window" id="mb_companies_action_window">
      <field name="name">Company List</field>
      <field name="res_model">mb_companies</field>
      <field name="view_mode">tree,form</field>
    </record>

   <!-- Top menu item -->
    
  </data>
</odoo>

<odoo>
  <data>

    <!-- movie_list_list_view -->
    <record model="ir.ui.view" id="movie_list_list_view">
      <field name="name">movie_list_list_view</field>
      <field name="model">movie_list</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="categories" widget="many2many_tags" options="{'color_field': 'color'}"/>
          <!-- <field name="category"/> -->
          <field name="author"/>
          <field name="release_date"/>
          <field name="price"/>
          <field name="my_currency_id" optional="hide" widget="badge"/>
        </tree>
      </field>
    </record>

    <!-- movie_list_form_view -->
    <record model="ir.ui.view" id="movie_list_form_view">
      <field name="name">movie_list_form_view</field>
      <field name="model">movie_list</field>
      <field name="arch" type="xml">
        <form>
            <header>
                <button name="print_movie_report" type="object" string="Print"/>
            </header>
            <div>
                <h1>
                    <field name="quality" widget="priority"/>
                    <field name="movie_image" widget="image" class="oe_avatar" nolabel="1"/>
                </h1>
            </div>
            <group>
              <field name="name" help="Write a movie name" required="1"/>
              <field name="is_new_movie" widget="radio" help="Click or not if it is new or not :)"/>
              <field name="categories" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True,
                  'color_field': 'color'}"/>
              <!-- <field name="category" required="1" help="Select at least one category of your movie" 
                     widget="selection" placeholder="Selcet any of the option"/> -->
              <field name="author"/>
              <field name="release_date" placeholder="fields.Date.today"/>
              <field name="premiere_night" string="Premiere Night" readonly="1"/>
              <field name="price" required="1"/>
              <field name="my_currency_id" options="{'no_create': True, 'no_create_edit': True}"/>
              <field name="movie_trailer" filename="trailer_file_name"/>
              <field name="trailer_file_name" invisible="1"/>
              <field name="description" options="{'sandboxedPreview': True}"/>          
            </group>
        </form>
      </field>
    </record>

    <!-- movie_list_action_window -->
    <record model="ir.actions.act_window" id="movie_list_action_window">
      <field name="name">Movie List</field>
      <field name="res_model">movie_list</field>
      <field name="context">{'default_is_new_movie':'yes'}</field>
      <field name="view_mode">tree,form</field>
    </record>

   <!-- Top menu item -->
      
  </data>
</odoo>

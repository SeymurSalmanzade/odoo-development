<odoo>
  <data>

    <record id="book_store_search_view" model="ir.ui.view">
        <field name="name">book.store.search.view</field>
        <field name="model">book_store.book_store</field>
        <field name="arch" type="xml">
            <search>
                <!-- custom search view -->
                <field name="name" string="Name" filter_domain="['|',('name', 'ilike', self),
                                                                 ('seller_name', 'ilike', self)]"/>
                <field name="genres" string="Book Genre" filter_domain="[('genres', 'ilike', self)]"/>
                <field name="author" string="Book Author" filter_domain="[('author', 'ilike', self)]"/>
                <field name="seller_person" string="Seller Name" filter_domain="[('seller_person', 'ilike', self)]"/>
                <field name="currency_id" string="Currencies" filter_domain="[('currency_id', 'ilike', self)]"/>
                <field name="seller_company" string="Seller Company" filter_domain="[('seller_company', 'ilike', self)]"/>
 
                <filter string="New"
                        name="new_books"
                        domain="[('is_new_book', '=', 'True')]"/>
                
                <filter string="Used"
                        name="used_book"
                        domain="[('is_new_book', '=', 'False')]"/>

                <separator/>
                
                <filter string="AZN"
                        name="curency_id"
                        domain="[('currency_id', '=', 'AZN')]"/>
                
                <filter string="Others"
                        name="currency_id"
                        domain="[('currency_id', '!=', 'AZN')]"/>

                <separator/>

                <filter string="> 15"
                        name="more_than_10"
                        domain="[('final_price', '>', 15)]"/>

                <separator/>

                <filter string="Today's Releases"
                        name="today_filter"
                        domain="[('release_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                
                <filter string="This week"
                        name="seven_days_filter"
                        domain="[('release_date', '>=', (context_today() - datetime.timedelta(6)).strftime('%Y-%m-%d'))]"/>

                <filter string="This month"
                        name="this_month_filter"
                        domain="[('release_date', '>=', context_today().strftime('%Y-%m-01'))]"/>

                <filter string="A year"
                        name="one_year_filter"
                        domain="[('release_date', '>=', (context_today() + datetime.timedelta(-365)).strftime('%Y-%m-%d'))]"/>

                <filter string="More than a year"
                        name="more_than_a_year_filter"
                        domain="[('release_date', '&lt;', (context_today() + datetime.timedelta(-365)).strftime('%Y-%m-%d'))]"/>

                <group string="Group By">
                    <filter name="name_group"
                            string="Book Names"
                            context="{'group_by':'name'}"/>
                    
                    <filter name="author_group"
                            string="Author"
                            context="{'group_by':'author'}"/>

                    <filter name="genre_group"
                            string="Genre"
                            context="{'group_by':'genres'}"/>

                    <filter name="seller_name"
                            string="Seller"
                            context="{'group_by':'seller_person'}"/>

                    <filter name="price_group"
                            string="Price"
                            context="{'group_by':'final_price'}"/>
                </group>
                
                <searchpanel>
                    <field name="seller_company"
                           icon="fa fa-filter"
                           select="multi"
                           enable_counters="1"/>
                </searchpanel>
                
            </search>
        </field>
    </record>
        
    <!-- book_list_list_view -->
    <record model="ir.ui.view" id="book_store.list_view">
      <field name="name">book_store_list_view</field>
      <field name="model">book_store.book_store</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="genres" widget="selection" options="{'color_field': 'color'}"/>
          <field name="author"/>
          <field name="release_date"/>
          <field name="final_price"/>
          <field name="currency_id" optional="hide" widget="badge"/>
        </tree>
      </field>
    </record>

    <!-- book_list_form_view -->
    <record model="ir.ui.view" id="book_store.form_view">
      <field name="name">book_store_form_view</field>
      <field name="model">book_store.book_store</field>
      <field name="arch" type="xml">
        <form>
            <sheet>
                <group>
                    <group>
                      <field name="name" help="Write a book name" required="1"/>
                      <field name="is_new_book" widget="boolean_toggle" help="Click or not if it is new or not :)"/>
                      <!-- <field name="genres" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True, 
                             'color_field'= 'color'}"/> -->
                      <field name="genres" required="1" help="Select the genre of your book" 
                             widget="selection" placeholder="Selcet any of the option"/>
                      <field name="author"/>
                    </group>
                    <group>
                        <field name="seller_reference_id" string="Seller"/>
                        <field name="seller_person"/>
                        <field name="mobile"/>
                        <field name="seller_company"/>
                        <field name="email"/>
                        <field name="book_images" widget="many2many_binary"/>
                        <field name="description_compute"/>
                    </group>
                    <group>
                        <field name="create_date" placeholder="fields.Date.today"/>
                        <field name="release_date" string="Release Date"/>
                        <field name="price" required="1"/>
                        <field name="discount_price"/>
                        <field name="final_price" forcesave="True"/>
                        <field name="currency_id" options="{'no_create': True, 'no_create_edit': True}" groups="base.group_no_one"/>
                        <field name="description" widget="text_emojis"/>
                    </group>
                </group>
            </sheet>
        </form>
      </field>
    </record>
      
    <!-- book_store.action_window -->
    <record model="ir.actions.act_window" id="book_store.action_window">
      <field name="name">Book List</field>
      <field name="res_model">book_store.book_store</field>
      <field name="context">{'search_default_genre_group':1, 'search_default_more_than_10':1}</field>
                        <!-- 'active_test':False - many2one field'inde search zamani archive olanlari da gosterir -->
      <field name="view_mode">tree,form</field>
    </record>

   <!-- Top menu item -->
      
  </data>
</odoo>

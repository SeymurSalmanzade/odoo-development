<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    
    <template id="movie_store_report_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- custom report, image, table etc. -->
                        <h1 class="text-center" style="font-weight: bold;">Movies</h1>
                        <hr style="background-color: black;"/>
                        <table style="border: 1pt solid black; border-collapse: separate;">
                            <thead><b>Movie IDs</b></thead>
                            <tr style="background-color: cyan;">
                                <th><span t-esc="doc.name"/></th>
                            </tr>
                            <tr>
                                <td>
                                    
                                    <!-- STATIC IMAGES -->
                                    <!-- <img src="/book_store/demo/demo.png"
                                         alt="Not Found" height="200" width="150"/> -->
                                    
                                    <!-- <img src="https://tr.web.img2.acsta.net/pictures/bzp/01/29276.jpg"
                                         alt="Movie Image Link" style="max-height: 200px; max-width: 150px;"/> -->
                                    
                                    
                                    <!-- DYNAMIC IMAGES -->
                                    <img t-if="doc.movie_image"
                                        style="max-height: 250pt; max-width: 200pt;"
                                        t-att-src="image_data_uri(doc.movie_image)"
                                        alt="Movie Image"/>
                                </td>
                            </tr>
                        </table>

                        
                        <!-- <t t-foreach="doc.currency_id.movie_lists_id" t-as="rct">
                            <h1 t-esc="rct.name"/>
                            Queue: <span t-esc="rct_index"/>
                            <p>Is this first? <span t-esc="rct_first"/></p>
                            <p t-if="doc.is_new_movie == 'yes'">This is new movie</p>
                            <p t-else="">This movie is old</p>
                        </t> -->
                    </div>
                </t>
            </t>
        </t>
    </template>
    
    <record id="movie_store_report_temp" model="ir.actions.report">
        <field name="name">Movie Report</field>
        <field name="model">movie_list</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">book_store.movie_store_report_template</field>
        <field name="report_file">book_store.movie_store_report_template</field>
        <field name="print_report_name">'Movie Report'</field>
        <field name="binding_model_id" ref="model_movie_list"/>
        <field name="binding_type">report</field>
    </record>
</odoo>